{
  "mcpServers": {
    "muyu-search": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "<path-to-your-muyu-search-mcp>",
        "muyu-search"
      ],
      "env": {
        "MUYU_PROVIDER": "custom",
        "MUYU_API_URL": "https://api.camel-hub.com/v1",
        "MUYU_API_KEY": "sk-REPLACE_WITH_YOUR_MUYU_API_KEY",
        "MUYU_MODEL": "grok-4.1-fast",
        "TAVILY_API_KEY": "tvly-dev-REPLACE_WITH_YOUR_TAVILY_API_KEY",
        "TAVILY_API_URL": "https://api.tavily.com",
        "FIRECRAWL_API_KEY": "fc-REPLACE_WITH_YOUR_FIRECRAWL_API_KEY"
      }
    }
  }
}
